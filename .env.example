# Copy this file to .env and fill in the keys for the providers you use.
# Variable names must match api_env_var in configs/models.yaml.
# Note: every model that is enabled in models.yaml needs its key set.
OPENAI_API_KEY=your_real_openai_key_here
GEMINI_API_KEY=your_real_gemini_key_here
ANTHROPIC_API_KEY=your_real_anthropic_key_here
